# SALVIAN AI VIDEO NEW — production configuration
# Never commit real API keys. Set these in Vercel Environment Variables.

# AI production package (script/storyboard/SEO)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# IMPORTANT: Mureka is a short-clip provider and is NOT the final 5–8 minute renderer.
# Do not route the long-form render through Mureka's 15–30 second generation API.
MUREKA_RENDER_PROVIDER=mureka
MUREKA_API_KEY=
MUREKA_VIDEO_MODEL=doubao-seedance-2-5-260628
MUREKA_VIDEO_GENERATE_URL=https://api.mureka.ai/v1/video/generate
MUREKA_VIDEO_QUERY_URL_TEMPLATE=

# Proven SALVIAN long-form render bridge used by Video NEW.
# The endpoint must accept the long-form-video JSON contract used by lib/render-engine.ts
# and return a real task id. The status endpoint must return the task status and final MP4 URL.
# Defaults point to the existing SALVIAN AI CREATOR long-form bridge, so these may remain blank
# when the deployed environment uses that existing bridge.
SALVIAN_LONG_VIDEO_RENDER_URL=https://salvian-ai-creator.vercel.app/api/video
SALVIAN_LONG_VIDEO_RENDER_KEY=
SALVIAN_LONG_VIDEO_STATUS_URL_TEMPLATE=https://salvian-ai-creator.vercel.app/api/video?taskId={task_id}

# Optional generic renderer; not used for the 5–8 minute production path above.
RENDER_ENGINE_URL=
RENDER_ENGINE_API_KEY=
