# SALVIAN AI VIDEO NEW — production configuration
# Never commit real API keys. Set these in Vercel Environment Variables.

# AI production package (script/storyboard/SEO)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Native Salvian AI Video production engine.
# Video NEW no longer routes final video generation through Salvian AI Creator,
# Mureka, or another external video-product bridge.
# The native engine adapter is the only render slot used by /api/render.
SALVIAN_NATIVE_VIDEO_ENGINE=enabled

# Optional future native-worker configuration.
# These remain intentionally empty until the native Salvian video worker is implemented.
SALVIAN_NATIVE_RENDER_WORKER_URL=
SALVIAN_NATIVE_RENDER_WORKER_KEY=

# Generic renderer variables are retained only as placeholders for the native
# implementation and are not used by the current render adapter.
RENDER_ENGINE_URL=
RENDER_ENGINE_API_KEY=
