# SALVIAN AI VIDEO NEW — production configuration
# Never commit real secrets. Set them only in Vercel Environment Variables.

# AI production package (script/storyboard/SEO)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Durable render job database
DATABASE_URL=

# Source asset storage (direct browser upload)
BLOB_READ_WRITE_TOKEN=

# Native video engine — Seedance 2.5
SEEDANCE_API_KEY=
SEEDANCE_API_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-5-260628

# Native video engine — Kling 3.0 / 3.0 Omni
KLING_API_KEY=
KLING_API_URL=https://api-singapore.klingai.com

# Native video engine — Veo 3.1 on Google Cloud / Vertex AI
VEO_ACCESS_TOKEN=
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VEO_API_URL=https://us-central1-aiplatform.googleapis.com/v1
VEO_MODEL=veo-3.1-generate-001
# Optional: GCS folder such as gs://your-bucket/salvian-output/
VEO_OUTPUT_STORAGE_URI=

# Final media assembly service. It receives the ordered clip URLs/URIs and returns one final MP4/WebM URL.
MEDIA_ASSEMBLER_URL=
MEDIA_ASSEMBLER_API_KEY=

# Native engine feature switch
SALVIAN_NATIVE_VIDEO_ENGINE=enabled

# Legacy worker variables are retained for compatibility only.
SALVIAN_NATIVE_RENDER_WORKER_URL=
SALVIAN_NATIVE_RENDER_WORKER_KEY=
RENDER_ENGINE_URL=
RENDER_ENGINE_API_KEY=
