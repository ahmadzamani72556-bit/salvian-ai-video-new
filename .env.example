# SALVIAN AI VIDEO — production engine configuration
# Never commit real API keys. Set these in the deployment provider's environment variables.

# AI production package (script/storyboard/SEO)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Final video/audio engine provider
MUREKA_RENDER_PROVIDER=mureka
MUREKA_API_KEY=
MUREKA_VIDEO_MODEL=doubao-seedance-2-5-260628
# Official Mureka endpoint from the Video Generation API documentation.
# Leave blank to use the built-in default.
MUREKA_VIDEO_GENERATE_URL=https://api.mureka.ai/v1/video/generate
# Fill this from the official Mureka "Query task" documentation before enabling polling.
MUREKA_VIDEO_QUERY_URL_TEMPLATE=

# Optional generic renderer fallback. The endpoint must accept the RenderEngineRequest JSON.
RENDER_ENGINE_URL=
RENDER_ENGINE_API_KEY=
